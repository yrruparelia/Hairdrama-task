# Flask Backend — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to Git

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Keep secret! Bypasses RLS.
SUPABASE_ANON_KEY=your-anon-key-here

# ── Flask ─────────────────────────────────────────────────────
FLASK_ENV=development                  # Change to 'production' on Railway/Render
FLASK_SECRET_KEY=change-this-to-a-random-secret-string  # Used to sign sessions

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=another-strong-random-secret    # Used to sign JWT tokens
JWT_EXPIRY_HOURS=24                            # Token validity duration

# ── Google OAuth 2.0 ─────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: http://localhost:5000/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# This is where Google redirects after login
# Local dev:  http://localhost:5000/auth/callback
# Production: https://your-backend.railway.app/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

# ── Frontend URL ─────────────────────────────────────────────
# Used by Flask for CORS whitelist and OAuth redirect after login
# Local dev:  http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# ── Gmail API Email ──────────────────────────────────────────
# The sender address must be the Google account that authorized the refresh token.
GMAIL_SENDER_ADDRESS=yashruparelia8105@gmail.com
# Generate a refresh token locally with the Gmail send scope, then store it in Render.
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
